# Fill these values in the deployment secret store; never commit a real key.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=pilot.example.org
CORS_ALLOWED_ORIGINS=https://pilot.example.org
CSRF_TRUSTED_ORIGINS=https://pilot.example.org
BEHIND_HTTPS_PROXY=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
POSTGRES_DB=dayc2_pilot
POSTGRES_USER=dayc2_pilot
POSTGRES_PASSWORD=replace-in-secret-store
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
