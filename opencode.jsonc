{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "notebooklm": {
      "type": "local",
      "command": [
        "npx",
        "notebooklm-mcp@latest"
      ],
      "enabled": true
    },
    "google-docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@a-bonus/google-docs-mcp"
      ],
      "enabled": true
    }
  }
}
